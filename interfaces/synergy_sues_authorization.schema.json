{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://synergy.example/schemas/synergy_sues_authorization.schema.json",
  "title":"SYNERGY SUES Federation Authorization Contracts V1",
  "$defs":{
    "authorizationRequestPayload":{
      "type":"object","required":["request_id","action","resource_type","resource_id"],
      "properties":{
        "request_id":{"type":"string","minLength":1},
        "action":{"type":"string","minLength":1},
        "resource_type":{"type":"string","minLength":1},
        "resource_id":{"type":"string","minLength":1}
      },
      "additionalProperties":true
    },
    "authorizationApprovalPayload":{
      "type":"object","required":["request_id","action","resource_type","resource_id","requester_identity_id","decision"],
      "properties":{
        "request_id":{"type":"string","minLength":1},
        "action":{"type":"string","minLength":1},
        "resource_type":{"type":"string","minLength":1},
        "resource_id":{"type":"string","minLength":1},
        "requester_identity_id":{"type":"string","minLength":1},
        "decision":{"enum":["APPROVE","REJECT"]}
      },
      "additionalProperties":true
    },
    "authorizationRule":{
      "type":"object","required":["rule_id","tenant_id","effect","action","resource_type","subject_ids","approver_ids","min_approvals","valid_from"],
      "properties":{
        "rule_id":{"type":"string","minLength":1},
        "tenant_id":{"type":"string","minLength":1},
        "effect":{"enum":["ALLOW","DENY"]},
        "action":{"type":"string","minLength":1},
        "resource_type":{"type":"string","minLength":1},
        "resource_id":{"type":["string","null"]},
        "subject_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "approver_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "min_approvals":{"type":"integer","minimum":0},
        "valid_from":{"type":"string","format":"date-time"},
        "valid_until":{"type":["string","null"],"format":"date-time"}
      },
      "additionalProperties":false
    }
  }
}