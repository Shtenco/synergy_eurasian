{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/sle_award_authorization.schema.json",
  "title": "SYNERGY SLE Signed Award Authorization V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "award_id", "source_contribution_id", "result_digest",
    "beneficiary_id", "issuer_id", "service_code", "unit", "quantity",
    "capacity_id", "policy_version", "budget_ref", "issued_at", "expires_at",
    "signer_id", "signer_role", "key_id", "signature"
  ],
  "properties": {
    "schema": { "const": "sle.award-authorization/v1" },
    "award_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source_contribution_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "result_digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "beneficiary_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "issuer_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "service_code": { "type": "string", "minLength": 1, "maxLength": 256 },
    "unit": { "type": "string", "minLength": 1, "maxLength": 256 },
    "quantity": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "capacity_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "budget_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signer_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "signer_role": { "const": "REWARD_AUTHORIZER" },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "signature": { "type": "string", "contentEncoding": "base64", "minLength": 1 }
  }
}
