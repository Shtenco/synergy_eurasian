{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/synergy_sues_v7_bridge.schema.json",
  "title": "SYNERGY SUES V7 source and realization bridge",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/source_event" },
    { "$ref": "#/$defs/realization_link" },
    { "$ref": "#/$defs/realization_bridge" }
  ],
  "$defs": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2,11}$"
    },
    "unit": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_./*-]{0,31}$"
    },
    "nonnegative_decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "$ref": "#/$defs/nonnegative_decimal" },
        "currency": { "$ref": "#/$defs/currency" }
      }
    },
    "source_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_event_id", "source_event_hash", "previous_hash",
        "aggregate_type", "aggregate_id", "sequence", "event_type",
        "effective_at", "recorded_at", "source_ref", "evidence_ids",
        "idempotency_key", "payload_json"
      ],
      "properties": {
        "source_event_id": { "type": "string", "minLength": 1 },
        "source_event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "previous_hash": { "type": "string", "pattern": "^(?:[a-f0-9]{64})?$" },
        "aggregate_type": { "type": "string", "minLength": 1 },
        "aggregate_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "effective_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "source_ref": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "idempotency_key": { "type": "string" },
        "payload_json": { "type": "string", "minLength": 2 }
      }
    },
    "realization_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id", "record_type", "effective_date", "source_ref",
        "evidence_refs", "related_record_ids", "entity_id", "project_id",
        "benefit_stream_id", "period_id", "quantity", "unit", "amount",
        "evidence_status", "payload_json"
      ],
      "properties": {
        "source_record_id": { "type": "string", "minLength": 1 },
        "record_type": { "enum": [
          "OUTPUT_OBSERVATION", "DELIVERY_ACCEPTANCE", "TRADE_DOCUMENT",
          "INVOICE_DELIVERY_ALLOCATION", "SETTLEMENT",
          "COLLECTION_ATTRIBUTION", "COST_OBSERVATION"
        ] },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "source_ref": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "related_record_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "entity_id": { "type": "string" },
        "project_id": { "type": "string" },
        "benefit_stream_id": { "type": "string" },
        "period_id": { "type": "string" },
        "quantity": { "oneOf": [{ "$ref": "#/$defs/nonnegative_decimal" }, { "type": "null" }] },
        "unit": { "type": "string" },
        "amount": { "oneOf": [{ "$ref": "#/$defs/money" }, { "type": "null" }] },
        "evidence_status": { "type": ["string", "null"], "enum": ["OBSERVED", "VERIFIED", "UNDERWRITTEN", "SCENARIO", null] },
        "payload_json": { "type": "string", "minLength": 2 }
      }
    },
    "realization_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "links", "validated_report_json"],
      "properties": {
        "as_of": { "type": "string", "format": "date" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/realization_link" } },
        "validated_report_json": { "type": "string", "minLength": 2 }
      }
    }
  }
}