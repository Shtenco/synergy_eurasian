{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/payment_intent.schema.json",
  "title": "SYNERGY PaymentIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["payment_intent_id", "entity_id", "beneficiary_id", "amount", "currency", "purpose", "authorization_id", "source_event_id", "created_at", "expires_at", "idempotency_key", "status", "evidence_ids"],
  "properties": {
    "payment_intent_id": {"type": "string", "minLength": 3},
    "entity_id": {"type": "string", "minLength": 1},
    "beneficiary_id": {"type": "string", "minLength": 1},
    "amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$", "not": {"const": "0"}},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "purpose": {"type": "string", "minLength": 3},
    "authorization_id": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 8},
    "status": {"enum": ["CREATED", "APPROVED", "DISPATCHED", "SETTLED", "FAILED", "CANCELLED"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}