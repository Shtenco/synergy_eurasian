{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/project_proposal.schema.json",
  "title": "SYNERGY ProjectProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id", "model_run_id", "country", "sector", "name",
    "capex", "physical_output", "dependencies", "evidence_plan",
    "risk", "legal", "economics", "status"
  ],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 3},
    "model_run_id": {"type": "string", "minLength": 3},
    "country": {"enum": ["RU", "KZ", "BY", "AM", "KG"]},
    "sector": {"type": "string", "minLength": 2},
    "name": {"type": "string", "minLength": 3},
    "description": {"type": "string"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {"type": "string"},
        "region": {"type": "string"},
        "city": {"type": "string"},
        "site_id": {"type": "string"},
        "lat": {"type": ["number", "null"]},
        "lon": {"type": ["number", "null"]}
      }
    },
    "capex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount", "estimate_class"],
      "properties": {
        "currency": {"type": "string"},
        "amount": {"type": "number", "exclusiveMinimum": 0},
        "estimate_class": {"enum": ["concept", "pre_feasibility", "feasibility", "fid_ready"]},
        "contingency_pct": {"type": "number", "minimum": 0}
      }
    },
    "physical_output": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "unit", "target"],
        "properties": {
          "metric": {"type": "string"},
          "unit": {"type": "string"},
          "target": {"type": "number"},
          "baseline": {"type": ["number", "null"]},
          "measurement_source": {"type": ["string", "null"]}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "required_value", "unit"],
        "properties": {
          "kind": {"type": "string"},
          "required_value": {"type": "number"},
          "unit": {"type": "string"},
          "secured": {"type": "boolean"}
        }
      }
    },
    "economics": {
      "type": "object",
      "required": ["model_status", "gva_equivalent_is_cash"],
      "properties": {
        "model_status": {"enum": ["scenario", "pre_feasibility", "underwritten"]},
        "gva_equivalent_is_cash": {"const": false},
        "expected_external_revenue": {"type": ["number", "null"]},
        "expected_operating_cashflow": {"type": ["number", "null"]},
        "payback_years": {"type": ["number", "null"], "minimum": 0},
        "offtake_coverage_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
      }
    },
    "risk": {
      "type": "object",
      "required": ["risk_class", "downside_case", "stop_conditions"],
      "properties": {
        "risk_class": {"enum": ["low", "medium", "high", "experimental"]},
        "downside_case": {"type": "string"},
        "stop_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["milestone_id", "description", "required_evidence_types"],
        "properties": {
          "milestone_id": {"type": "string"},
          "description": {"type": "string"},
          "required_evidence_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "legal": {
      "type": "object",
      "required": ["spv_identified", "jurisdiction_review_required", "retail_distribution_assumed"],
      "properties": {
        "spv_identified": {"type": "boolean"},
        "jurisdiction_review_required": {"const": true},
        "retail_distribution_assumed": {"const": false},
        "notes": {"type": "string"}
      }
    },
    "status": {"enum": ["model_candidate", "review", "rejected", "approved_for_underwriting", "funded", "building", "commissioned", "operating", "closed"]}
  }
}
