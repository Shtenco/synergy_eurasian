{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/synergy_sues_authority_scope.schema.json",
  "title": "SYNERGY SUES Authority Scope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope_id", "tenant_id", "action", "resource_type", "subject_ids", "currencies", "max_per_transaction", "period_limit", "period_window", "resource_id", "allowed_organization_ids", "allowed_account_ids", "allowed_counterparty_ids", "initiator_role", "approval_roles"],
  "properties": {
    "scope_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource_type": {"type": "string", "minLength": 1},
    "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "currencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{3}$"}},
    "max_per_transaction": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "period_limit": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "period_window": {"enum": ["DAY", "WEEK", "MONTH", "YEAR"]},
    "resource_id": {"type": ["string", "null"], "minLength": 1},
    "allowed_organization_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_account_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_counterparty_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "initiator_role": {"type": ["string", "null"], "minLength": 1},
    "approval_roles": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role_id", "minimum_approvals"],
        "properties": {
          "role_id": {"type": "string", "minLength": 1},
          "minimum_approvals": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}