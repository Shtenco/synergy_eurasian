{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/accounting_snapshot.schema.json",
  "title": "SYNERGY AccountingSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot_id", "entity_id", "period_id", "as_of", "known_at", "functional_currency", "cash_balance", "total_assets", "total_liabilities", "equity", "period_revenue", "period_expenses", "journal_hash", "reconciliation_status", "evidence_ids"],
  "properties": {
    "snapshot_id": {"type": "string", "minLength": 3},
    "entity_id": {"type": "string", "minLength": 1},
    "period_id": {"type": "string", "minLength": 4},
    "as_of": {"type": "string", "format": "date-time"},
    "known_at": {"type": "string", "format": "date-time"},
    "functional_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "cash_balance": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "total_assets": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "total_liabilities": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "equity": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "period_revenue": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "period_expenses": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "journal_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reconciliation_status": {"enum": ["VERIFIED", "UNRECONCILED", "EXCEPTION"]},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}