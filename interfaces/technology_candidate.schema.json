{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/technology_candidate.schema.json",
  "title": "SYNERGY TechnologyCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["technology_id", "name", "problem", "claimed_effect", "trl", "evidence", "next_gate", "economics", "status"],
  "properties": {
    "technology_id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 3},
    "problem": {"type": "string", "minLength": 10},
    "claimed_effect": {
      "type": "object",
      "required": ["metric", "baseline", "target", "unit"],
      "properties": {
        "metric": {"type": "string"},
        "baseline": {"type": ["number", "null"]},
        "target": {"type": ["number", "null"]},
        "unit": {"type": "string"},
        "claim_status": {"enum": ["HYPOTHESIS", "SIMULATED", "LAB_OBSERVED", "PILOT_OBSERVED", "REPLICATED"]}
      }
    },
    "trl": {"type": "integer", "minimum": 0, "maximum": 9},
    "evidence": {
      "type": "object",
      "required": ["independent_replications", "references"],
      "properties": {
        "independent_replications": {"type": "integer", "minimum": 0},
        "references": {"type": "array", "items": {"type": "string"}},
        "content_hashes": {"type": "array", "items": {"type": "string"}},
        "known_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "next_gate": {
      "type": "object",
      "required": ["description", "required_capex", "currency", "success_criteria"],
      "properties": {
        "description": {"type": "string"},
        "required_capex": {"type": "number", "minimum": 0},
        "currency": {"type": "string"},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "economics": {
      "type": "object",
      "required": ["unrisked_project_value", "probability_science", "probability_scale", "probability_market"],
      "properties": {
        "unrisked_project_value": {"type": ["number", "null"]},
        "currency": {"type": ["string", "null"]},
        "probability_science": {"type": "number", "minimum": 0, "maximum": 1},
        "probability_scale": {"type": "number", "minimum": 0, "maximum": 1},
        "probability_certification": {"type": "number", "minimum": 0, "maximum": 1},
        "probability_market": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "ip": {
      "type": "object",
      "properties": {
        "patent_status": {"type": ["string", "null"]},
        "freedom_to_operate_status": {"type": ["string", "null"]},
        "owner": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["RESEARCH", "FALSIFICATION", "LAB", "PROTOTYPE", "PILOT", "QUALIFIED", "COMMERCIAL", "REJECTED"]},
    "notes": {"type": "string"}
  }
}
