{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/labor_contribution.schema.json",
  "title": "SYNERGY Labor Contribution V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "contributor_id",
    "contributor_kind",
    "project_id",
    "benefit_stream_id",
    "result_digest",
    "category",
    "status",
    "effort_units",
    "effort_unit",
    "complexity_factor",
    "quality_factor",
    "outcome_factor",
    "reliability_factor",
    "attribution_share",
    "evidence",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "contribution_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contributor_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contributor_kind": { "enum": ["HUMAN", "AI_AGENT", "JOINT"] },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "benefit_stream_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "result_digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "category": {
      "enum": [
        "PRODUCTION", "INTELLECTUAL", "TECHNICAL", "ENTREPRENEURIAL",
        "COORDINATION", "CARE_SOCIAL", "INFRASTRUCTURE", "EDUCATION",
        "MAINTENANCE", "AI_AGENT", "HUMAN_AI_JOINT"
      ]
    },
    "status": { "enum": ["SUBMITTED", "ACCEPTED", "DISPUTED", "REJECTED"] },
    "effort_units": { "type": "number", "exclusiveMinimum": 0 },
    "effort_unit": { "type": "string", "minLength": 1, "maxLength": 64 },
    "hours_observed": { "type": ["number", "null"], "minimum": 0 },
    "complexity_factor": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
    "quality_factor": { "type": "number", "minimum": 0, "maximum": 1 },
    "outcome_factor": { "type": "number", "minimum": 0, "maximum": 2.0 },
    "reliability_factor": { "type": "number", "minimum": 0, "maximum": 1 },
    "attribution_share": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "sha256", "source", "independent"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "source": { "type": "string", "minLength": 1 },
          "independent": { "type": "boolean" },
          "captured_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_id",
        "independent_from_contributor",
        "conflict_disclosed",
        "signature_reference"
      ],
      "properties": {
        "verifier_id": { "type": "string", "minLength": 1 },
        "independent_from_contributor": { "const": true },
        "conflict_disclosed": { "const": true },
        "signature_reference": { "type": "string", "minLength": 1 }
      }
    },
    "supersedes_contribution_id": { "type": ["string", "null"] },
    "revision_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ACCEPTED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": { "independent": { "const": true } },
              "required": ["independent"]
            }
          }
        }
      }
    }
  ]
}
