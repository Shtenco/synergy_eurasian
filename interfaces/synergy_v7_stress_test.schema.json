{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/synergy_v7_stress_test.schema.json",
  "title": "SYNERGY V7.5 Fixed Schedule Stress Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipes",
    "orders",
    "inventory_receipts",
    "demands",
    "resource_capacities"
  ],
  "properties": {
    "scenarios": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "common_shock_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "common_capacity_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "demand_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recipe_id",
          "output_product_id",
          "output_quantity_per_batch",
          "output_unit",
          "input_requirements",
          "resource_requirements",
          "lead_time_periods"
        ],
        "properties": {
          "recipe_id": {
            "type": "string"
          },
          "output_product_id": {
            "type": "string"
          },
          "output_quantity_per_batch": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "output_unit": {
            "type": "string"
          },
          "lead_time_periods": {
            "type": "integer",
            "minimum": 1
          },
          "node_id": {
            "type": "string"
          },
          "input_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "product_id",
                "quantity_per_batch",
                "unit"
              ],
              "properties": {
                "product_id": {
                  "type": "string"
                },
                "quantity_per_batch": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          },
          "resource_requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "resource_id",
                "quantity_per_batch",
                "unit"
              ],
              "properties": {
                "resource_id": {
                  "type": "string"
                },
                "quantity_per_batch": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "recipe_id",
          "start_period",
          "batch_count"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "recipe_id": {
            "type": "string"
          },
          "start_period": {
            "type": "integer",
            "minimum": 0
          },
          "batch_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "inventory_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_id",
          "product_id",
          "quantity",
          "unit",
          "available_period",
          "status"
        ],
        "properties": {
          "receipt_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          },
          "available_period": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "OBSERVED",
              "COMMITTED",
              "UNDER_CONSTRUCTION",
              "PLANNED",
              "ANNOUNCED",
              "SCENARIO"
            ]
          }
        }
      }
    },
    "demands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "demand_id",
          "product_id",
          "quantity",
          "unit",
          "due_period"
        ],
        "properties": {
          "demand_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          },
          "due_period": {
            "type": "integer",
            "minimum": 0
          },
          "priority": {
            "type": "integer"
          }
        }
      }
    },
    "resource_capacities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource_id",
          "period",
          "available_quantity",
          "unit",
          "status",
          "evidence_id"
        ],
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "available_quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "status": {
            "enum": [
              "OBSERVED",
              "COMMITTED",
              "UNDER_CONSTRUCTION",
              "PLANNED",
              "ANNOUNCED",
              "SCENARIO"
            ]
          },
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "resource_shocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource_id",
          "probability",
          "capacity_factor"
        ],
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "capacity_factor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "receipt_delays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_id",
          "probability",
          "max_delay_periods"
        ],
        "properties": {
          "receipt_id": {
            "type": "string"
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "max_delay_periods": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
