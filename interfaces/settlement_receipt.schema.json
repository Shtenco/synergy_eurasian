{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synergy.example/schemas/settlement_receipt.schema.json",
  "title": "SYNERGY SettlementReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["settlement_receipt_id", "payment_intent_id", "provider", "provider_reference", "payer_entity_id", "payee_id", "amount", "currency", "settled_at", "external_transaction_id", "evidence_package_id", "source_event_id", "status"],
  "properties": {
    "settlement_receipt_id": {"type": "string", "minLength": 3},
    "payment_intent_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "provider_reference": {"type": "string", "minLength": 1},
    "payer_entity_id": {"type": "string", "minLength": 1},
    "payee_id": {"type": "string", "minLength": 1},
    "amount": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$", "not": {"pattern": "^0+(?:\\.0+)?$"}},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "settled_at": {"type": "string", "format": "date-time"},
    "external_transaction_id": {"type": "string", "minLength": 1},
    "evidence_package_id": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["CONFIRMED", "REVERSED", "DISPUTED"]}
  }
}