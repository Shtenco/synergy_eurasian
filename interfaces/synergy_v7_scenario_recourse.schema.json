{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY V7.7 Scenario Recourse Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_plan",
    "scenarios"
  ],
  "properties": {
    "base_plan": {
      "type": "object",
      "description": "Validated separately against the production optimizer schema by the scenario CLI."
    },
    "risk_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.95
    },
    "risk_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "probability"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "resource_capacity_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "demand_quantity_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "inventory_receipt_quantity_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "cash_inflow_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "cash_outflow_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "supplier_payment_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "receivable_collateral_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "inventory_collateral_multipliers": {
            "$ref": "#/$defs/multipliers"
          },
          "credit_borrowing_base_multipliers": {
            "$ref": "#/$defs/multipliers"
          }
        }
      }
    }
  },
  "$defs": {
    "multipliers": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  }
}
