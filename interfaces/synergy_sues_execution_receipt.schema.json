{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://synergy.example/schemas/synergy_sues_execution_receipt.schema.json",
  "title":"SYNERGY SUES Authorized Execution Receipt V1",
  "type":"object",
  "additionalProperties":false,
  "required":["sequence","request_id","request_event_id","request_event_hash","action","resource_type","resource_id","requester_identity_id","executed_at","result_json","decision_json","previous_hash","receipt_hash"],
  "properties":{
    "sequence":{"type":"integer","minimum":1},
    "request_id":{"type":"string","minLength":1},
    "request_event_id":{"type":"string","minLength":1},
    "request_event_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "action":{"type":"string","minLength":1},
    "resource_type":{"type":"string","minLength":1},
    "resource_id":{"type":"string","minLength":1},
    "requester_identity_id":{"type":"string","minLength":1},
    "executed_at":{"type":"string","format":"date-time"},
    "result_json":{"type":"string","contentMediaType":"application/json"},
    "decision_json":{"type":"string","contentMediaType":"application/json"},
    "previous_hash":{"type":"string"},
    "receipt_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}